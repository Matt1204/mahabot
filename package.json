{
  "name": "mahabot",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "bin": {
    "mahabot": "dist/cli.js"
  },
  "scripts": {
    "dev": "tsx src/cli.ts cli",
    "cli": "tsx src/cli.ts cli",
    "telegram": "tsx src/cli.ts telegram",
    "playground": "tsx src/cli.ts playground",
    "test": "tsx --test tests/*.test.ts tests/**/*.test.ts",
    "build": "tsc -p tsconfig.json && node scripts/copy-config-templates.mjs",
    "start": "node dist/cli.js"
  },
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "@mariozechner/pi-agent-core": "^0.57.1",
    "@mariozechner/pi-ai": "^0.57.1",
    "dotenv": "^16.6.1",
    "telegraf": "^4.16.3",
    "yaml": "^2.8.3"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "tsx": "^4.20.5",
    "typescript": "^5.9.2"
  }
}
